# Copy to .env.docker.local (ignored), chmod 600, then fill in the values.
# Generate with: openssl rand -hex 32
APP_SECRET=
HTTP_PORT=8080
REVIEW_IMAGE=visual-release-review:local
# Leave both empty for public demo mode without paid API calls.
OPENAI_API_KEY=
SNAPSHOT_SITE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required when API keys are configured. Use HTTPS at the reverse proxy.
REVIEW_BASIC_USER=reviewer
# Keep bcrypt hashes in single quotes to preserve literal dollar signs.
REVIEW_BASIC_PASSWORD_HASH=''
# Only the exact IP or CIDR of your reverse proxy; empty for direct local access.
TRUSTED_PROXIES=
