{% extends 'base.html.twig' %}
{% block title %}{{ report.verdict.label|trans }} · Snapshot Site Release Review{% endblock %}
{% block body %}
<section class="report-heading"><a href="{{ path('home', {lang: app.request.locale}) }}" class="text-link">{{ 'Nouvelle comparaison'|trans }}</a><p class="eyebrow">{{ 'REVUE VISUELLE'|trans }} <span class="dot">/</span> MOBILE 390 × 844</p><h1>{{ 'Voilà ce que l’on voit.'|trans }}</h1>{% if report.replay %}<p class="replay-notice">{{ 'Exemple préenregistré · captures et analyses d’exemple, sans appel aux agents.'|trans }}</p>{% else %}<p class="replay-notice">{{ 'Comparaison réelle · captures Snapshot Site et analyse Symfony AI.'|trans }}</p>{% endif %}</section>
<section class="verdict-panel {{ report.verdict.value }}" aria-label="{{ 'Résultat'|trans }}"><span class="verdict-badge" data-testid="verdict">{{ report.verdict.label|trans }}</span><h2>« {{ report.input.claim }} »</h2><p>{% if report.disagreement %}{{ 'Les agents ne concluent pas la même chose. Le résultat reste indéterminé ; examinez les preuves avant de trancher.'|trans }}{% elseif report.verdict.value == 'uncertain' %}{{ 'Les captures ne suffisent pas à conclure. Une nouvelle capture peut aider.'|trans }}{% else %}{{ 'Les deux lectures convergent sur cette observation visuelle.'|trans }}{% endif %}</p></section>
<section class="evidence-section"><div class="section-heading"><h2>{{ 'Les images, avant les conclusions.'|trans }}</h2>{% if report.evidence.mismatch is not null %}<span class="metric">{{ report.evidence.mismatch|number_format(2, app.request.locale == 'fr' ? ',' : '.', ' ') }} {{ '% de pixels différents'|trans }} <span>{{ '· ce n’est pas une mesure de gravité'|trans }}</span></span>{% endif %}</div><div class="evidence-grid">{% for label, url in {'Avant': report.evidence.before, 'Après': report.evidence.after} %}<figure><figcaption><span>{{ label|trans }}</span><span>390 × 844 px</span></figcaption><a href="{{ url }}" target="_blank" rel="noopener noreferrer"><img src="{{ url }}" alt="{{ ('Capture mobile ' ~ label|lower ~ ' la modification')|trans }}" width="390" height="844"></a></figure>{% endfor %}</div>{% if report.evidence.diff %}<details class="diff"><summary>{{ 'Afficher la différence de pixels'|trans }}</summary><img src="{{ report.evidence.diff }}" alt="{{ 'Différence visuelle entre les deux captures'|trans }}" width="390" height="844"></details>{% endif %}</section>
<section class="agent-grid" aria-label="{{ 'Les deux lectures'|trans }}">{% for name, finding in {'Inspecteur': report.inspector, 'Critique': report.critic} %}<article class="agent-card panel"><div class="agent-title"><span class="agent-avatar" aria-hidden="true">{{ loop.index == 1 ? 'I' : 'C' }}</span><div><span class="eyebrow">{{ (loop.index == 1 ? 'PREMIÈRE LECTURE' : 'SECONDE LECTURE')|trans }}</span><h2>{{ name|trans }}</h2></div><span class="small-badge {{ finding.verdict.value }}">{{ finding.verdict.label|trans }}</span></div><p>{{ finding.observation }}</p><p class="evidence-reference">{{ 'Preuve :'|trans }} {{ (finding.evidence == 'both' ? 'captures avant et après' : (finding.evidence == 'before' ? 'capture avant' : 'capture après'))|trans }}.</p><p class="limitation">{{ finding.limitation }}</p></article>{% endfor %}</section>
<aside class="report-note">{{ 'Cette revue porte sur un état visuel précis. Elle ne vérifie pas les interactions ni le bon fonctionnement d’un paiement.'|trans }}</aside>
<section class="next-step"><div><p class="eyebrow">{{ 'À VOTRE TOUR'|trans }}</p><h2>{{ 'Faites votre première comparaison.'|trans }}</h2><p>{{ 'Retrouvez les captures et la comparaison visuelle dans Snapshot Site.'|trans }}</p></div><a class="button primary" href="https://console.snapshot-site.com/?utm_source=release-review&utm_medium=demo&utm_campaign=symfony-hackathon">{{ 'Essayer Snapshot Site'|trans }}</a></section>
{% endblock %}
